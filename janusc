#!/usr/bin/env python3
"""
Launcher eseguibile per il compilatore e toolchain JANUS (janusc).
"""
import sys
import os

# Assicura che la directory corrente sia nel path di importazione
current_dir = os.path.dirname(os.path.abspath(__file__))
if current_dir not in sys.path:
    sys.path.insert(0, current_dir)

from janus.cli import main

if __name__ == "__main__":
    main()
