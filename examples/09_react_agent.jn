# examples/09_react_agent.jn
# Programma 9: Agente Autonomo ReAct con Tool-Calling e Gestione Retry

schema Action {
    tool: str,
    args: str
} -> {
    result: str,
    ok: bool
}

fn agent_exec(task:m: str, max_retries: i32 = 3) io {
    mut history = [task:m]
    for r in 0..max_retries {
        action = call agentv Planner prompt:m history tool:b Action
        if action.ok {
            ret action.result
        }
        history = history cat ["Errore:", action.result]
    }
    ret "Fallimento task"
}
