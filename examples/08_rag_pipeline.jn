# examples/08_rag_pipeline.jn
# Programma 8: Pipeline RAG Avanzata con Ranking e Chiamata ad Agente

schema SearchQuery {
    q: str,
    topk: i32 = 5
} -> {
    docs: vec[str],
    scores: vec[f32]
}

fn rag_pipeline(query:m: str) io {
    docs_out = call agentv Retriever prompt:m query:m tool:b SearchQuery
    selected = docs_out.docs
    ans = call agentv LLM prompt:m ["Contesto:", selected, "Domanda:", query:m]
    ret ans
}
