# examples/04_training_loop.jn
# Programma 4: Training Loop Completo con Batching e Mutazione di Stato

type ModelWeights {
    w: mat[f32, D, C],
    b: vec[f32, C]
}

fn step(x:m, y:m, mut model:t: ModelWeights, lr: f32) pure {
    pred:n = x:m matmul model:t.w add model:t.b
    loss:n = ((pred:n - y:m) pow 2) sum / x:m.len
    g = diff loss:n wrt model:t
    mut model:t = model:t - lr * g
    ret loss:n
}

fn train_loop(data:m, labels:m, mut model:t: ModelWeights, epochs: i32, bs: i32, lr: f32) pure {
    for ep in 0..epochs {
        for b in 0..(data:m.len / bs) {
            x:b = data:m[b * bs .. (b + 1) * bs]
            y:b = labels:m[b * bs .. (b + 1) * bs]
            loss:n = step x:b y:b model:t lr
        }
    }
}
