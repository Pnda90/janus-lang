# examples/01_linreg.jn
# Programma 1: Regressione Lineare con SGD e Differenziazione Automatica Nativa

fn linreg(x:m, y:m, epochs: i32, lr: f32) pure {
    mut w:b = 0.0
    mut b:b = 0.0
    for ep in 0..epochs {
        pred:n = x:m * w:b + b:b
        loss:n = ((pred:n - y:m) pow 2) sum / x:m.len
        gw, gb = diff loss:n wrt (w:b, b:b)
        w:b = w:b - lr * gw
        b:b = b:b - lr * gb
    }
    ret (w:b, b:b)
}
