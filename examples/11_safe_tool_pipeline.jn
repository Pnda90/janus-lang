# examples/11_safe_tool_pipeline.jn
# Programma 11: Pipeline di orchestrazione tool con validazione di schema e type safety

schema SearchEngine io {
    query: str,
    top_k: i32 = 5
} -> {
    raw_results: str
}

schema TextClassifier pure {
    content: str,
    threshold: f32 = 0.5
} -> {
    is_relevant: bool,
    confidence: f32
}

schema CacheStorage io {
    key: str,
    value: str
} -> {
    status: str
}

fn orchestrate_search_and_cache(query: str, min_confidence: f32) io {
    search_res = call tool SearchEngine(query = query, top_k = 3)
    filter_res = call tool TextClassifier(content = search_res.raw_results, threshold = min_confidence)
    if filter_res.is_relevant {
        cache_res = call tool CacheStorage(key = query, value = search_res.raw_results)
        ret 1
    }
    ret 0
}
