# examples/02_mlp.jn
# Programma 2: Multi-Layer Perceptron (MLP) a 2 Strati con ReLU e Backward Pass

type MLP {
    w1: mat[f32, D, H],
    b1: vec[f32, H],
    w2: mat[f32, H, C],
    b2: vec[f32, C]
}

fn mlp_step(x:m, y:m, mlp:b: MLP, lr: f32) pure {
    pred:n = x:m matmul mlp:b.w1 add mlp:b.b1 relu matmul mlp:b.w2 add mlp:b.b2
    loss:n = ((pred:n - y:m) pow 2) sum / x:m.len
    g = diff loss:n wrt mlp:b
    ret (mlp:b - lr * g, loss:n)
}
