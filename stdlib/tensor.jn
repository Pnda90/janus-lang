# stdlib/tensor.jn: Operazioni fondamentali sui tensori

fn dot_prod(a:m: vec[f32, D], b:b: vec[f32, D]) -> scal[f32] pure {
    ret dot a:m b:b
}

fn mat_mul(x:m: mat[f32, M, K], w:b: mat[f32, K, N]) -> mat[f32, M, N] pure {
    ret x:m matmul w:b
}

fn transpose_2d(x:m: mat[f32, M, N]) -> mat[f32, N, M] pure {
    ret x:m.trans
}

fn tensor_norm(x:m: tens[f32, B, S, D], eps: f32 = 1e-5) pure {
    v = (x:m pow 2) sum ax:b -1 keep:b true / x:m.dim_last
    ret x:m / (v + eps sqrt)
}
